{
  "name": "emovie-showtime-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "playwright test",
    "test": "vitest run src",
    "format:check": "prettier --check src tests *.ts *.json index.html README.md",
    "format": "prettier --write src tests *.ts *.json index.html README.md"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@tanstack/react-query": "^5.106.1",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "prettier": "^3.9.10",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^5.1.0"
  }
}
